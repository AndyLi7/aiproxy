{
  "contract": {
    "artifacts": [
      {
        "path": [
          "images",
          "*",
          "url"
        ]
      }
    ],
    "fixed_parameters": {
      "enable_safety_checker": true
    },
    "input_schema": {
      "allOf": [
        {
          "not": {
            "required": [
              "enable_safety_checker"
            ]
          }
        }
      ],
      "components": {
        "schemas": {
          "File": {
            "properties": {
              "content_type": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The mime type of the file.",
                "examples": [
                  "image/png"
                ],
                "title": "Content Type"
              },
              "file_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The name of the file. It will be auto-generated if not provided.",
                "examples": [
                  "z9RV14K95DvU.png"
                ],
                "title": "File Name"
              },
              "file_size": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The size of the file in bytes.",
                "examples": [
                  4404019
                ],
                "title": "File Size"
              },
              "url": {
                "description": "The URL where the file can be downloaded from.",
                "title": "Url",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "title": "File",
            "type": "object",
            "x-fal-order-properties": [
              "url",
              "content_type",
              "file_name",
              "file_size"
            ]
          },
          "ImageSize": {
            "properties": {
              "height": {
                "default": 512,
                "description": "The height of the generated image.",
                "exclusiveMinimum": 0,
                "maximum": 14142,
                "title": "Height",
                "type": "integer"
              },
              "width": {
                "default": 512,
                "description": "The width of the generated image.",
                "exclusiveMinimum": 0,
                "maximum": 14142,
                "title": "Width",
                "type": "integer"
              }
            },
            "title": "ImageSize",
            "type": "object",
            "x-fal-order-properties": [
              "width",
              "height"
            ]
          },
          "QueueStatus": {
            "properties": {
              "cancel_url": {
                "description": "The cancel url.",
                "type": "string"
              },
              "logs": {
                "additionalProperties": true,
                "description": "The logs.",
                "type": "object"
              },
              "metrics": {
                "additionalProperties": true,
                "description": "The metrics.",
                "type": "object"
              },
              "queue_position": {
                "description": "The queue position.",
                "type": "integer"
              },
              "request_id": {
                "description": "The request id.",
                "type": "string"
              },
              "response_url": {
                "description": "The response url.",
                "type": "string"
              },
              "status": {
                "enum": [
                  "IN_QUEUE",
                  "IN_PROGRESS",
                  "COMPLETED"
                ],
                "type": "string"
              },
              "status_url": {
                "description": "The status url.",
                "type": "string"
              }
            },
            "required": [
              "status",
              "request_id"
            ],
            "type": "object"
          },
          "V26ImageToImageInput": {
            "description": "Input for Wan 2.6 image editing with reference images (enable_interleave=false)",
            "properties": {
              "enable_prompt_expansion": {
                "default": true,
                "description": "Enable LLM prompt optimization. Significantly improves results for simple prompts but adds 3-4 seconds processing time.",
                "title": "Enable Prompt Expansion",
                "type": "boolean"
              },
              "enable_safety_checker": {
                "default": true,
                "description": "Enable content moderation for input and output. Disabling it requires account authorization; unauthorized requests are always checked.",
                "title": "Enable Safety Checker",
                "type": "boolean"
              },
              "image_size": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ImageSize"
                  },
                  {
                    "enum": [
                      "square_hd",
                      "square",
                      "portrait_4_3",
                      "portrait_16_9",
                      "landscape_4_3",
                      "landscape_16_9"
                    ],
                    "type": "string"
                  }
                ],
                "default": "square_hd",
                "description": "Output image size. Use presets like 'square_hd', 'landscape_16_9', 'portrait_9_16', or specify exact dimensions with ImageSize(width=1280, height=720). Total pixels must be between 768*768 and 1280*1280.",
                "examples": [
                  "square_hd",
                  "landscape_16_9",
                  "portrait_4_3"
                ],
                "title": "Image Size"
              },
              "image_urls": {
                "description": "Reference images for editing (1-3 images required). Order matters: reference as 'image 1', 'image 2', 'image 3' in prompt. Resolution: 384-5000px each dimension. Max size: 10MB each. Formats: JPEG, JPG, PNG (no alpha), BMP, WEBP.",
                "examples": [
                  [
                    "https://v3b.fal.media/files/b/0a86d6a7/6smIczyPbvAU3IJ1F5Ok3.png",
                    "https://v3b.fal.media/files/b/0a86d6a7/nTYVlOfKLD1FqHAGy7KS3.png",
                    "https://v3b.fal.media/files/b/0a86d6ae/6JA70jOe0-pbDtXLF2roV.png"
                  ]
                ],
                "items": {
                  "_fal_ui_field": "image",
                  "type": "string"
                },
                "title": "Image Urls",
                "type": "array"
              },
              "negative_prompt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": "",
                "description": "Content to avoid in the generated image. Max 500 characters.",
                "examples": [
                  "low resolution, error, worst quality, low quality, deformed, extra fingers"
                ],
                "title": "Negative Prompt"
              },
              "num_images": {
                "default": 1,
                "description": "Number of images to generate (1-4). Directly affects billing cost.",
                "maximum": 4,
                "minimum": 1,
                "title": "Num Images",
                "type": "integer"
              },
              "prompt": {
                "description": "Text prompt describing the desired image. Supports Chinese and English. Max 2000 characters. Example: 'Generate an image using the style of image 1 and background of image 2'.",
                "examples": [
                  "Place the wizard from image 2 in the ancient library from image 3, holding and studying the magical crystal orb from image 1. The orb's glow illuminates his face with purple and blue light. Floating candles around him, ancient books visible in the background. Mystical, dramatic lighting, fantasy art style, highly detailed."
                ],
                "minLength": 1,
                "title": "Prompt",
                "type": "string"
              },
              "seed": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Random seed for reproducibility (0-2147483647). Same seed produces more consistent results.",
                "title": "Seed"
              }
            },
            "required": [
              "prompt",
              "image_urls"
            ],
            "title": "ImageEditInput",
            "type": "object",
            "x-fal-order-properties": [
              "prompt",
              "image_urls",
              "negative_prompt",
              "image_size",
              "num_images",
              "enable_prompt_expansion",
              "seed",
              "enable_safety_checker"
            ]
          },
          "V26ImageToImageOutput": {
            "description": "Output for Wan 2.6 image editing",
            "properties": {
              "images": {
                "description": "Generated images in PNG format",
                "examples": [
                  [
                    {
                      "content_type": "image/png",
                      "file_name": "output_1.png",
                      "url": "https://v3b.fal.media/files/b/0a86d6bb/iSEuXzi3kDy1jnlMCwYuH_output_3.png"
                    }
                  ]
                ],
                "items": {
                  "$ref": "#/components/schemas/File"
                },
                "title": "Images",
                "type": "array"
              },
              "seed": {
                "description": "The seed used for generation",
                "examples": [
                  175932751
                ],
                "title": "Seed",
                "type": "integer"
              }
            },
            "required": [
              "images",
              "seed"
            ],
            "title": "ImageEditOutput",
            "type": "object",
            "x-fal-order-properties": [
              "images",
              "seed"
            ]
          }
        },
